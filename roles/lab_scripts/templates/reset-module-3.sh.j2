#!/bin/bash
#
# Script: reset-module-3.sh
# Purpose: Reset Module 3 to initial state
# Undoes: Developer user creation, ConfigMap, and pipeline secrets
#

set -e

# Initialize environment variables
export LAB_ASSETS_DIR="{{ rhpds_build_secured_dev_workflows_lab_scripts_output_dir }}"
export CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}
export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

# Namespace variables
export KEYCLOAK_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_keycloak_namespace }}"
export DEVSPACES_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_devspaces_namespace }}"
export APP_CI_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_app_ci_namespace }}"

# SSO Configuration
export SSO_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_sso_realm }}"
export DEVELOPER_USERNAME="{{ rhpds_build_secured_dev_workflows_lab_scripts_developer_username }}"

echo "========================================="
echo "Resetting Module 3: Developer Setup"
echo "========================================="
echo ""

#######################################
# Step 1: Delete Pipeline Secrets
#######################################
echo "Step 1: Deleting pipeline secrets..."
echo "-------------------------------------"

if oc get secret tpa-secret -n ${APP_CI_NAMESPACE} 2>/dev/null; then
    oc delete secret tpa-secret -n ${APP_CI_NAMESPACE}

    # Verify deletion
    if ! oc get secret tpa-secret -n ${APP_CI_NAMESPACE} 2>/dev/null; then
        echo "✓ tpa-secret deleted"
    else
        echo "Warning: tpa-secret still exists"
    fi
else
    echo "✓ tpa-secret not found (already clean)"
fi

if oc get secret gitlab-auth-secret -n ${APP_CI_NAMESPACE} 2>/dev/null; then
    oc delete secret gitlab-auth-secret -n ${APP_CI_NAMESPACE}

    # Verify deletion
    if ! oc get secret gitlab-auth-secret -n ${APP_CI_NAMESPACE} 2>/dev/null; then
        echo "✓ gitlab-auth-secret deleted"
    else
        echo "Warning: gitlab-auth-secret still exists"
    fi
else
    echo "✓ gitlab-auth-secret not found (already clean)"
fi
echo ""

#######################################
# Step 2: Delete Dev Spaces ConfigMap
#######################################
echo "Step 2: Deleting Dev Spaces ConfigMap..."
echo "-----------------------------------------"

if oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} 2>/dev/null; then
    oc delete configmap tas-git-config -n ${DEVSPACES_NAMESPACE}

    # Verify deletion
    if ! oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} 2>/dev/null; then
        echo "✓ tas-git-config ConfigMap deleted"
    else
        echo "Warning: tas-git-config ConfigMap still exists"
    fi
else
    echo "✓ tas-git-config ConfigMap not found (already clean)"
fi
echo ""

#######################################
# Step 3: Delete Developer User
#######################################
echo "Step 3: Deleting developer user..."
echo "-----------------------------------"

# Get Keycloak admin credentials
KEYCLOAK_ADMIN_USER=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.username}' | base64 -d)
KEYCLOAK_ADMIN_PASSWORD=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.password}' | base64 -d)

# Get admin access token
ADMIN_TOKEN=$(curl -s -X POST "${KEYCLOAK_URL}/realms/master/protocol/openid-connect/token" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "client_id=admin-cli" \
  -d "username=${KEYCLOAK_ADMIN_USER}" \
  -d "password=${KEYCLOAK_ADMIN_PASSWORD}" \
  -d "grant_type=password" | jq -r '.access_token')

if [ -z "$ADMIN_TOKEN" ] || [ "$ADMIN_TOKEN" == "null" ]; then
    echo "Warning: Failed to authenticate with Keycloak, skipping user deletion"
else
    # Check if user exists
    USER_ID=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${SSO_REALM}/users?username=${DEVELOPER_USERNAME}" | jq -r '.[0].id // empty')

    if [ -n "$USER_ID" ]; then
        # Delete user
        curl -s -X DELETE "${KEYCLOAK_URL}/admin/realms/${SSO_REALM}/users/${USER_ID}" \
          -H "Authorization: Bearer ${ADMIN_TOKEN}"

        # Verify user deletion
        VERIFY_USER=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
          "${KEYCLOAK_URL}/admin/realms/${SSO_REALM}/users?username=${DEVELOPER_USERNAME}" | jq -r '.[0].id // empty')

        if [ -z "$VERIFY_USER" ]; then
            echo "✓ Deleted developer user: ${DEVELOPER_USERNAME}"
        else
            echo "Warning: Developer user ${DEVELOPER_USERNAME} still exists"
        fi
    else
        echo "✓ Developer user not found (already clean)"
    fi
fi
echo ""

#######################################
# Step 4: Reset GitOps Backstage Configuration
#######################################
echo "Step 4: Resetting GitOps backstage configuration..."
echo "----------------------------------------------------"

bash ${LAB_ASSETS_DIR}/update-gitops-backstage-config.sh reset

echo ""

#######################################
# Step 5: Reset RHDH Devfile Configuration
#######################################
echo "Step 5: Resetting RHDH devfile configuration..."
echo "------------------------------------------------"

bash ${LAB_ASSETS_DIR}/update-rhdh-devfile-config.sh reset

echo ""

echo "========================================="
echo "Module 3 Reset Complete!"
echo "========================================="
echo ""
echo "Cleaned up:"
echo "  ✓ tpa-secret removed from ${APP_CI_NAMESPACE}"
echo "  ✓ gitlab-auth-secret removed from ${APP_CI_NAMESPACE}"
echo "  ✓ tas-git-config ConfigMap removed from ${DEVSPACES_NAMESPACE}"
echo "  ✓ Developer user (${DEVELOPER_USERNAME}) removed from Keycloak"
echo "  ✓ GitOps backstage configuration reset to initial state"
echo "  ✓ RHDH devfile configuration reset to initial state"
echo ""
