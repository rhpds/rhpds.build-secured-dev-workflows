#!/bin/bash
#
# Script: create-pipeline-secrets.sh
# Purpose: Create Pipeline Authentication Secrets - Showroom Module 3 Step 4.4
#
# This script automates:
# - Step 4.4: Configure pipeline authentication secrets
#   - tpa-secret: Credentials for uploading SBOMs to RHTPA
#   - gitlab-auth-secret: Credentials for authenticating to GitLab

set -e

# Initialize environment variables
export CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}

# Namespace variables
export APP_CI_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_app_ci_namespace }}"
export TPA_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_namespace }}"
export GITLAB_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_gitlab_namespace }}"

# TPA Configuration
export TPA_CLI_CLIENT_SECRET="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_cli_client_secret }}"
export TPA_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_keycloak_realm }}"
export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

echo "========================================="
echo "Creating Pipeline Authentication Secrets"
echo "========================================="
echo ""

#######################################
# Step 4.4.1: Create TPA Secret
#######################################
echo "Step 4.4.1: Creating tpa-secret..."
echo "-----------------------------------"

# Get TPA server URL
echo "Retrieving TPA server URL..."
export TPA_SERVER_URL="https://$(oc get route -l app.kubernetes.io/component=server -n ${TPA_NAMESPACE} -o json \
  | jq -r '.items[0].spec.host')"

if [ -z "$TPA_SERVER_URL" ] || [ "$TPA_SERVER_URL" == "https://" ]; then
    echo "Error: Failed to retrieve TPA server URL"
    exit 1
fi
echo "  TPA Server URL: ${TPA_SERVER_URL}"

# Apply tpa-secret
echo "Creating tpa-secret in namespace: ${APP_CI_NAMESPACE}..."
envsubst < $(eval echo "~/lab-assets/tpa-secret.yml") | oc apply -n ${APP_CI_NAMESPACE} -f -
echo "✓ tpa-secret created"
echo ""

#######################################
# Step 4.4.2: Create GitLab Secret
#######################################
echo "Step 4.4.2: Creating gitlab-auth-secret..."
echo "------------------------------------------"

# Get GitLab personal access token
echo "Retrieving GitLab personal access token..."
export GITLAB_TOKEN=$(oc get secret root-user-personal-token -n ${GITLAB_NAMESPACE} -o jsonpath='{.data.token}' | base64 -d)

if [ -z "$GITLAB_TOKEN" ]; then
    echo "Error: Failed to retrieve GitLab token"
    exit 1
fi
echo "✓ GitLab token retrieved"

# Apply gitlab-auth-secret
echo "Creating gitlab-auth-secret in namespace: ${APP_CI_NAMESPACE}..."
envsubst < $(eval echo "~/lab-assets/gitlab-auth-secret.yml") | oc apply -n ${APP_CI_NAMESPACE} -f -
echo "✓ gitlab-auth-secret created"
echo ""

echo "========================================="
echo "Pipeline Secrets Creation Complete!"
echo "========================================="
echo ""
echo "Secrets created in namespace: ${APP_CI_NAMESPACE}"
echo ""
echo "1. tpa-secret"
echo "   Purpose: Upload SBOMs to Red Hat Trusted Profile Analyzer"
echo "   Contains: TPA_SERVER_URL"
echo ""
echo "2. gitlab-auth-secret"
echo "   Purpose: Authenticate to GitLab for repository operations"
echo "   Contains: GITLAB_TOKEN"
echo ""
echo "The CI/CD pipeline can now:"
echo "  ✓ Upload SBOMs to RHTPA"
echo "  ✓ Create repositories in GitLab"
echo "  ✓ Push code to GitLab"
echo ""
