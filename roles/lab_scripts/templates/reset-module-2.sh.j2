#!/bin/bash
#
# Script: reset-module-2.sh
# Purpose: Reset Module 2 to initial state
# Undoes: RHTAS installation and image signing test
#

set -e

# Initialize environment variables
export CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}
export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

# Namespace variables
export KEYCLOAK_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_keycloak_namespace }}"
export TAS_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_namespace }}"
export PIPELINES_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_pipelines_namespace }}"
export APP_CI_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_app_ci_namespace }}"
export QUAY_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_quay_namespace }}"

# TAS Configuration
export TAS_CHAINS_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_chains_realm }}"
export TAS_SSO_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_sso_realm }}"
export TAS_CLIENT_ID="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_client_id }}"

# Quay Configuration
export QUAY_TOKEN="{{ rhpds_build_secured_dev_workflows_lab_scripts_quay_token }}"
export QUAY_ORG="tssc"
export QUAY_REPO="tekton-chains-test"

echo "========================================="
echo "Resetting Module 2: RHTAS Installation"
echo "========================================="
echo ""

#######################################
# Step 1: Revert Tekton Chains Configuration
#######################################
echo "Step 1: Reverting Tekton Chains configuration..."
echo "-------------------------------------------------"

# Reset Tekton Chains to default configuration - remove all fields set by tekton-chains-patch.yml
# Remove each field individually to avoid errors if some fields don't exist
CHAIN_FIELDS=(
  "artifacts.oci.format"
  "artifacts.oci.signer"
  "artifacts.oci.storage"
  "artifacts.pipelinerun.format"
  "artifacts.pipelinerun.storage"
  "artifacts.taskrun.format"
  "artifacts.taskrun.signer"
  "artifacts.taskrun.storage"
  "disabled"
  "options"
  "signers.x509.fulcio.address"
  "signers.x509.fulcio.enabled"
  "signers.x509.fulcio.issuer"
  "signers.x509.identity.token.file"
  "signers.x509.tuf.mirror.url"
  "transparency.enabled"
  "transparency.url"
)

for field in "${CHAIN_FIELDS[@]}"; do
  oc patch tektonconfig config -n ${PIPELINES_NAMESPACE} --type=json -p="[{\"op\": \"remove\", \"path\": \"/spec/chain/$field\"}]" 2>/dev/null || true
done

echo "✓ Tekton Chains configuration reverted"
echo ""

#######################################
# Step 2: Delete OIDC Refresher App
#######################################
echo "Step 2: Deleting OIDC refresher app..."
echo "---------------------------------------"

if oc get deployment oidc-token-refresher -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
    oc delete deployment oidc-token-refresher -n ${PIPELINES_NAMESPACE}
    # Verify deletion
    if ! oc get deployment oidc-token-refresher -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
        echo "✓ OIDC refresher deployment deleted"
    else
        echo "Warning: OIDC refresher deployment still exists"
    fi
else
    echo "✓ OIDC refresher deployment not found (already clean)"
fi

if oc get service oidc-token-refresher -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
    oc delete service oidc-token-refresher -n ${PIPELINES_NAMESPACE}
    # Verify deletion
    if ! oc get service oidc-token-refresher -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
        echo "✓ OIDC refresher service deleted"
    else
        echo "Warning: OIDC refresher service still exists"
    fi
else
    echo "✓ OIDC refresher service not found (already clean)"
fi

if oc get secret oidc-info -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
    oc delete secret oidc-info -n ${PIPELINES_NAMESPACE}
    # Verify deletion
    if ! oc get secret oidc-info -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
        echo "✓ OIDC info secret deleted"
    else
        echo "Warning: OIDC info secret still exists"
    fi
else
    echo "✓ OIDC info secret not found (already clean)"
fi

if oc get secret oidc-token -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
    oc delete secret oidc-token -n ${PIPELINES_NAMESPACE}
    # Verify deletion
    if ! oc get secret oidc-token -n ${PIPELINES_NAMESPACE} 2>/dev/null; then
        echo "✓ OIDC token secret deleted"
    else
        echo "Warning: OIDC token secret still exists"
    fi
else
    echo "✓ OIDC token secret not found (already clean)"
fi

echo "✓ OIDC refresher app removed"
echo ""

#######################################
# Step 3: Delete RHTAS Instance
#######################################
echo "Step 3: Deleting RHTAS instance..."
echo "-----------------------------------"

if oc get securesign -n ${TAS_NAMESPACE} trusted-artifact-signer 2>/dev/null; then
    oc delete securesign trusted-artifact-signer -n ${TAS_NAMESPACE}

    # Wait for RHTAS instance to be fully deleted
    echo "Waiting for RHTAS instance to be fully deleted..."
    oc wait --for=delete securesign/trusted-artifact-signer -n ${TAS_NAMESPACE} --timeout=300s 2>/dev/null || true

    # Verify deletion
    TIMEOUT=60
    ELAPSED=0
    while [ $ELAPSED -lt $TIMEOUT ]; do
        if ! oc get securesign trusted-artifact-signer -n ${TAS_NAMESPACE} 2>/dev/null; then
            echo "✓ RHTAS instance deleted"
            break
        fi
        sleep 5
        ELAPSED=$((ELAPSED + 5))
    done

    if oc get securesign trusted-artifact-signer -n ${TAS_NAMESPACE} 2>/dev/null; then
        echo "Warning: RHTAS instance still exists after timeout"
    fi

    # Wait for TUF pod to be deleted
    echo "Waiting for TUF pod to be deleted..."
    TIMEOUT=120
    ELAPSED=0
    while [ $ELAPSED -lt $TIMEOUT ]; do
        TUF_POD_COUNT=$(oc get pods -n ${TAS_NAMESPACE} -l app.kubernetes.io/component=tuf -o name 2>/dev/null | wc -l)
        if [ "$TUF_POD_COUNT" -eq 0 ]; then
            echo "✓ TUF pod deleted"
            break
        fi
        echo "TUF pod still present, waiting..."
        sleep 5
        ELAPSED=$((ELAPSED + 5))
    done

    if [ "$TUF_POD_COUNT" -gt 0 ]; then
        echo "Warning: TUF pod still exists after timeout"
    fi
else
    echo "✓ RHTAS instance not found (already clean)"
fi
echo ""

#######################################
# Step 4: Delete Keycloak Clients and Realm
#######################################
echo "Step 4: Deleting Keycloak clients and realm..."
echo "-----------------------------------------------"

# Get Keycloak admin credentials
KEYCLOAK_ADMIN_USER=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.username}' | base64 -d)
KEYCLOAK_ADMIN_PASSWORD=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.password}' | base64 -d)

# Get admin access token
ADMIN_TOKEN=$(curl -s -X POST "${KEYCLOAK_URL}/realms/master/protocol/openid-connect/token" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "client_id=admin-cli" \
  -d "username=${KEYCLOAK_ADMIN_USER}" \
  -d "password=${KEYCLOAK_ADMIN_PASSWORD}" \
  -d "grant_type=password" | jq -r '.access_token')

if [ -z "$ADMIN_TOKEN" ] || [ "$ADMIN_TOKEN" == "null" ]; then
    echo "Warning: Failed to authenticate with Keycloak, skipping client/realm deletion"
else
    # Delete trusted-artifact-signer client from sso realm
    SSO_CLIENT_ID=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${TAS_SSO_REALM}/clients?clientId=${TAS_CLIENT_ID}" | jq -r '.[0].id // empty')

    if [ -n "$SSO_CLIENT_ID" ]; then
        curl -s -X DELETE "${KEYCLOAK_URL}/admin/realms/${TAS_SSO_REALM}/clients/${SSO_CLIENT_ID}" \
          -H "Authorization: Bearer ${ADMIN_TOKEN}"

        # Verify client deletion
        VERIFY_CLIENT=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
          "${KEYCLOAK_URL}/admin/realms/${TAS_SSO_REALM}/clients?clientId=${TAS_CLIENT_ID}" | jq -r '.[0].id // empty')

        if [ -z "$VERIFY_CLIENT" ]; then
            echo "✓ Deleted ${TAS_CLIENT_ID} client from ${TAS_SSO_REALM} realm"
        else
            echo "Warning: ${TAS_CLIENT_ID} client still exists in ${TAS_SSO_REALM} realm"
        fi
    else
        echo "✓ ${TAS_CLIENT_ID} client not found in ${TAS_SSO_REALM} realm"
    fi

    # Delete tas-chains realm
    REALM_EXISTS=$(curl -s -o /dev/null -w "%{http_code}" \
      -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}")

    if [ "$REALM_EXISTS" == "200" ]; then
        curl -s -X DELETE "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}" \
          -H "Authorization: Bearer ${ADMIN_TOKEN}"

        # Verify realm deletion
        VERIFY_REALM=$(curl -s -o /dev/null -w "%{http_code}" \
          -H "Authorization: Bearer ${ADMIN_TOKEN}" \
          "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}")

        if [ "$VERIFY_REALM" != "200" ]; then
            echo "✓ Deleted ${TAS_CHAINS_REALM} realm"
        else
            echo "Warning: ${TAS_CHAINS_REALM} realm still exists"
        fi
    else
        echo "✓ ${TAS_CHAINS_REALM} realm not found"
    fi
fi
echo ""

#######################################
# Step 5: Clean Up Test TaskRuns
#######################################
echo "Step 5: Cleaning up test TaskRuns..."
echo "-------------------------------------"

# Delete all TaskRuns from the image signing test
TASKRUN_COUNT=$(oc get taskrun -n ${APP_CI_NAMESPACE} -l test.workload.security.redhat.com/test=image-signing --no-headers 2>/dev/null | wc -l || echo 0)

if [ "$TASKRUN_COUNT" -gt 0 ]; then
    oc delete taskrun -n ${APP_CI_NAMESPACE} -l test.workload.security.redhat.com/test=image-signing
    echo "✓ Deleted ${TASKRUN_COUNT} test TaskRun(s)"
else
    echo "✓ No test TaskRuns found"
fi

# Also delete any orphaned TaskRuns
ORPHANED_COUNT=$(oc get taskrun -n ${APP_CI_NAMESPACE} -l tekton.dev/task=build-and-push --no-headers 2>/dev/null | wc -l || echo 0)

if [ "$ORPHANED_COUNT" -gt 0 ]; then
    oc delete taskrun -n ${APP_CI_NAMESPACE} -l tekton.dev/task=build-and-push
    echo "✓ Deleted ${ORPHANED_COUNT} orphaned TaskRun(s)"
fi
echo ""

#######################################
# Step 6: Delete Quay Test Repository
#######################################
echo "Step 6: Deleting Quay test repository..."
echo "-----------------------------------------"

# Get Quay route
QUAY_URL=$(oc get route -n ${QUAY_NAMESPACE} -l quay-component=quay-app-route -o jsonpath='{.items[0].spec.host}' 2>/dev/null || echo "")

if [ -z "$QUAY_URL" ]; then
    echo "Warning: Could not find Quay route, skipping repository deletion"
else
    echo "Quay URL: https://${QUAY_URL}"
    echo "Checking repository: ${QUAY_ORG}/${QUAY_REPO}"

    if [ -z "$QUAY_TOKEN" ]; then
        echo "Warning: QUAY_TOKEN not set, skipping repository deletion"
        echo "  Set QUAY_TOKEN environment variable before running this script"
    else
        # Check if repository exists first
        CHECK_CODE=$(curl -k -s -o /dev/null -w "%{http_code}" \
          -H "Authorization: Bearer ${QUAY_TOKEN}" \
          "https://${QUAY_URL}/api/v1/repository/${QUAY_ORG}/${QUAY_REPO}")

        if [ "$CHECK_CODE" == "404" ]; then
            echo "✓ Quay repository not found (already clean): ${QUAY_ORG}/${QUAY_REPO}"
        elif [ "$CHECK_CODE" == "200" ]; then
            echo "Repository exists, deleting..."
            # Delete repository using Quay API
            HTTP_CODE=$(curl -k -s -o /dev/null -w "%{http_code}" -X DELETE \
              -H "Authorization: Bearer ${QUAY_TOKEN}" \
              "https://${QUAY_URL}/api/v1/repository/${QUAY_ORG}/${QUAY_REPO}")

            if [ "$HTTP_CODE" == "204" ] || [ "$HTTP_CODE" == "200" ]; then
                echo "✓ Quay repository deleted: ${QUAY_ORG}/${QUAY_REPO}"
            else
                echo "Warning: Failed to delete Quay repository (HTTP: ${HTTP_CODE})"
            fi
        elif [ "$CHECK_CODE" == "401" ]; then
            echo "Warning: Authentication failed for Quay (HTTP: 401)"
            echo "  Check QUAY_TOKEN is valid"
            echo "  Skipping deletion"
        else
            echo "Warning: Could not check Quay repository (HTTP: ${CHECK_CODE})"
            echo "  Skipping deletion"
        fi
    fi
fi
echo ""

echo "========================================="
echo "Module 2 Reset Complete!"
echo "========================================="
echo ""
echo "Cleaned up:"
echo "  ✓ Tekton Chains configuration reverted"
echo "  ✓ OIDC refresher app removed"
echo "  ✓ OIDC info and token secrets removed"
echo "  ✓ RHTAS instance removed (Fulcio, Rekor, TUF)"
echo "  ✓ tas-chains realm deleted from Keycloak"
echo "  ✓ trusted-artifact-signer client removed from sso realm"
echo "  ✓ Test TaskRuns cleaned up"
echo "  ✓ Quay test repository removed (tssc/tekton-chains-test)"
echo ""
