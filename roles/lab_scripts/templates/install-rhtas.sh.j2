#!/bin/bash
#
# Script: install-rhtas.sh
# Purpose: Install RHTAS - Showroom Module 2 Step 1
#
# This script automates:
# - Step 1: Configure Machine Identity (Tekton Chains)
# - Step 2: Configure Developer Identity for Commit Signing
# - Step 3: Deploy RHTAS Instance
# - Step 4: Deploy OIDC Refresher App
# - Step 5: Configure Tekton Chains

set -e

# Initialize environment variables
export LAB_ASSETS_DIR="{{ rhpds_build_secured_dev_workflows_lab_scripts_output_dir }}"
export CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}
export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

# Namespace variables
export KEYCLOAK_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_keycloak_namespace }}"
export TAS_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_namespace }}"
export PIPELINES_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_pipelines_namespace }}"

# TAS Configuration
export TAS_CHAINS_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_chains_realm }}"
export TAS_SSO_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_sso_realm }}"
export TAS_CLIENT_ID="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_client_id }}"

echo "========================================="
echo "Installing RHTAS"
echo "========================================="
echo ""

# Get Keycloak admin credentials
echo "Retrieving Keycloak admin credentials..."
KEYCLOAK_ADMIN_USER=""
KEYCLOAK_ADMIN_PASSWORD=""
while [ -z "$KEYCLOAK_ADMIN_USER" ] || [ -z "$KEYCLOAK_ADMIN_PASSWORD" ]; do
  KEYCLOAK_ADMIN_USER=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.username}' 2>/dev/null | base64 -d 2>/dev/null || true)
  KEYCLOAK_ADMIN_PASSWORD=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.password}' 2>/dev/null | base64 -d 2>/dev/null || true)
  if [ -z "$KEYCLOAK_ADMIN_USER" ] || [ -z "$KEYCLOAK_ADMIN_PASSWORD" ]; then
    echo "Waiting for Keycloak credentials to be available..."
    sleep 2
  fi
done

# Get admin access token
echo "Authenticating with Keycloak..."
ADMIN_TOKEN=$(curl -s -X POST "${KEYCLOAK_URL}/realms/master/protocol/openid-connect/token" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "client_id=admin-cli" \
  -d "username=${KEYCLOAK_ADMIN_USER}" \
  -d "password=${KEYCLOAK_ADMIN_PASSWORD}" \
  -d "grant_type=password" | jq -r '.access_token')

if [ -z "$ADMIN_TOKEN" ] || [ "$ADMIN_TOKEN" == "null" ]; then
    echo "Error: Failed to authenticate with Keycloak"
    exit 1
fi
echo "✓ Authenticated with Keycloak"
echo ""

#######################################
# Step 1: Configure Machine Identity
#######################################
echo "Step 1: Configure Machine Identity (Tekton Chains)"
echo "---------------------------------------------------"

# Step 1.2: Create tas-chains Realm
echo "Step 1.2: Creating tas-chains realm..."
REALM_EXISTS=$(curl -s -o /dev/null -w "%{http_code}" \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}")

if [ "$REALM_EXISTS" == "404" ]; then
    curl -s -X POST "${KEYCLOAK_URL}/admin/realms" \
      -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{
        \"realm\": \"${TAS_CHAINS_REALM}\",
        \"enabled\": true
      }"
    echo "✓ Created tas-chains realm"
else
    echo "✓ tas-chains realm already exists"
fi

# Step 1.3: Create trusted-artifact-signer client in tas-chains realm
echo "Step 1.3: Creating ${TAS_CLIENT_ID} client in ${TAS_CHAINS_REALM} realm..."

# Check if client exists
CLIENT_EXISTS=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients?clientId=${TAS_CLIENT_ID}" | jq -r '.[0].id // empty')

if [ -z "$CLIENT_EXISTS" ]; then
    # Create client
    curl -s -X POST "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients" \
      -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{
        \"clientId\": \"${TAS_CLIENT_ID}\",
        \"enabled\": true,
        \"clientAuthenticatorType\": \"client-secret\",
        \"standardFlowEnabled\": true,
        \"serviceAccountsEnabled\": true,
        \"publicClient\": false,
        \"frontchannelLogout\": false
      }"
    echo "✓ Created ${TAS_CLIENT_ID} client"

    # Get the newly created client ID
    CLIENT_ID=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients?clientId=${TAS_CLIENT_ID}" | jq -r '.[0].id')
else
    echo "✓ ${TAS_CLIENT_ID} client already exists"
    CLIENT_ID=$CLIENT_EXISTS
fi

# Configure service account user
echo "Configuring service account user..."
SERVICE_ACCOUNT_USER=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients/${CLIENT_ID}/service-account-user" | jq -r '.id')

# Update service account with email verification
curl -s -X PUT "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/users/${SERVICE_ACCOUNT_USER}" \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "{
    \"emailVerified\": true,
    \"email\": \"trusted-artifact-signer@demo.redhat.com\",
    \"firstName\": \"Trusted\",
    \"lastName\": \"Content\"
  }"
echo "✓ Service account configured with verified email"
echo ""

#######################################
# Step 2: Configure Developer Identity
#######################################
echo "Step 2: Configure Developer Identity for Commit Signing"
echo "--------------------------------------------------------"

# Step 2.1: Create trusted-artifact-signer client in sso realm
echo "Step 2.1: Creating ${TAS_CLIENT_ID} client in ${TAS_SSO_REALM} realm..."

# Check if client exists in sso realm
SSO_CLIENT_EXISTS=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  "${KEYCLOAK_URL}/admin/realms/${TAS_SSO_REALM}/clients?clientId=${TAS_CLIENT_ID}" | jq -r '.[0].id // empty')

if [ -z "$SSO_CLIENT_EXISTS" ]; then
    # Create client in sso realm
    curl -s -X POST "${KEYCLOAK_URL}/admin/realms/${TAS_SSO_REALM}/clients" \
      -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{
        \"clientId\": \"${TAS_CLIENT_ID}\",
        \"enabled\": true,
        \"standardFlowEnabled\": true,
        \"directAccessGrantsEnabled\": true,
        \"publicClient\": true,
        \"redirectUris\": [\"urn:ietf:wg:oauth:2.0:oob\", \"*\"],
        \"frontchannelLogout\": false
      }"
    echo "✓ Created ${TAS_CLIENT_ID} client in ${TAS_SSO_REALM} realm"
else
    echo "✓ ${TAS_CLIENT_ID} client already exists in ${TAS_SSO_REALM} realm"
fi
echo ""

#######################################
# Step 3: Deploy RHTAS Instance
#######################################
echo "Step 3: Deploy RHTAS Instance"
echo "------------------------------"

# Step 3.1: Set environment variables and apply RHTAS Instance CR
echo "Step 3.1: Applying RHTAS Instance CR..."

export TAS_CHAINS_CLIENT_ID=${TAS_CLIENT_ID}
export TAS_CHAINS_REALM=${TAS_CHAINS_REALM}
export TAS_SSO_REALM=${TAS_SSO_REALM}

envsubst < $(eval echo "${LAB_ASSETS_DIR}/tas-instance.yml") | oc apply -n ${TAS_NAMESPACE} -f -
echo "✓ RHTAS Instance CR applied"

# Step 3.2: Wait for RHTAS instance status URLs to be populated
echo "Step 3.2: Waiting for RHTAS instance status to be populated..."
TIMEOUT=600
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
    FULCIO_URL=$(oc get securesign trusted-artifact-signer -n ${TAS_NAMESPACE} -o jsonpath='{.status.fulcio.url}' 2>/dev/null || echo "")
    REKOR_URL=$(oc get securesign trusted-artifact-signer -n ${TAS_NAMESPACE} -o jsonpath='{.status.rekor.url}' 2>/dev/null || echo "")
    TUF_URL=$(oc get securesign trusted-artifact-signer -n ${TAS_NAMESPACE} -o jsonpath='{.status.tuf.url}' 2>/dev/null || echo "")

    if [ -n "$FULCIO_URL" ] && [ -n "$REKOR_URL" ] && [ -n "$TUF_URL" ]; then
        echo "✓ RHTAS instance status populated"
        echo "  Fulcio URL: ${FULCIO_URL}"
        echo "  Rekor URL: ${REKOR_URL}"
        echo "  TUF URL: ${TUF_URL}"
        break
    fi
    echo "Waiting for RHTAS status URLs to be populated..."
    sleep 10
    ELAPSED=$((ELAPSED + 10))
done

if [ $ELAPSED -ge $TIMEOUT ]; then
    echo "Error: RHTAS instance status not populated after ${TIMEOUT} seconds"
    exit 1
fi
echo ""

#######################################
# Step 4: Deploy OIDC Refresher App
#######################################
echo "Step 4: Deploy OIDC Refresher App"
echo "----------------------------------"

# Step 4.1: Retrieve client secret for tas-chains realm
echo "Step 4.1: Retrieving client secret..."
TAS_CHAINS_CLIENT_ID_UUID=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients?clientId=${TAS_CLIENT_ID}" | jq -r '.[0].id')

TAS_CHAINS_CLIENT_SECRET=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients/${TAS_CHAINS_CLIENT_ID_UUID}/client-secret" | jq -r '.value')

if [ -z "$TAS_CHAINS_CLIENT_SECRET" ] || [ "$TAS_CHAINS_CLIENT_SECRET" == "null" ]; then
    echo "Error: Failed to retrieve client secret"
    exit 1
fi
echo "✓ Client secret retrieved"

# Step 4.2: Create OIDC info secret
echo "Step 4.2: Creating OIDC info secret..."
export TAS_CHAINS_CLIENT_SECRET
envsubst < $(eval echo "${LAB_ASSETS_DIR}/oidc-info-secret.yml") | oc apply -n ${PIPELINES_NAMESPACE} -f -
echo "✓ OIDC info secret created"

# Step 4.3: Deploy OIDC refresher app
echo "Step 4.3: Deploying OIDC refresher app..."
oc apply -f $(eval echo "${LAB_ASSETS_DIR}/oidc-refresher-app.yml") -n ${PIPELINES_NAMESPACE}
echo "✓ OIDC refresher app deployed"

# Step 4.4: Wait for refresher pod to be Running
echo "Step 4.4: Waiting for OIDC refresher pod to be Running..."
TIMEOUT=300
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
    REFRESHER_STATUS=$(oc get pods -n ${PIPELINES_NAMESPACE} -l app=oidc-token-refresher -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "NotFound")
    if [ "$REFRESHER_STATUS" == "Running" ]; then
        echo "✓ OIDC refresher pod is Running"
        break
    fi
    sleep 5
    ELAPSED=$((ELAPSED + 5))
done

if [ $ELAPSED -ge $TIMEOUT ]; then
    echo "Error: OIDC refresher pod not ready after ${TIMEOUT} seconds"
    exit 1
fi

# Step 4.5: Wait for oidc-token secret to have valid id-token
echo "Step 4.5: Waiting for oidc-token secret to have valid id-token..."
TIMEOUT=120
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
    ID_TOKEN=$(oc get secret oidc-token -n ${PIPELINES_NAMESPACE} -o jsonpath='{.data.id-token}' 2>/dev/null | base64 -d 2>/dev/null || true)
    if [ -n "$ID_TOKEN" ] && [[ "$ID_TOKEN" == eyJ* ]]; then
        echo "✓ oidc-token secret has valid id-token"
        break
    fi
    echo "Waiting for oidc-token secret to be populated..."
    sleep 5
    ELAPSED=$((ELAPSED + 5))
done

if [ -z "$ID_TOKEN" ] || [[ "$ID_TOKEN" != eyJ* ]]; then
    echo "Error: oidc-token secret does not have a valid id-token after ${TIMEOUT} seconds"
    exit 1
fi
echo ""

#######################################
# Step 5: Configure Tekton Chains
#######################################
echo "Step 5: Configure Tekton Chains"
echo "--------------------------------"

echo "Step 5.1: Getting current tekton-chains-controller pod..."
OLD_CHAINS_POD=$(oc get pods -n ${PIPELINES_NAMESPACE} -l app=tekton-chains-controller -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "NotFound")
echo "Current pod: ${OLD_CHAINS_POD}"

echo "Step 5.2: Patching Tekton configuration..."
oc patch tektonconfig config -n ${PIPELINES_NAMESPACE} --type=merge --patch "$(cat $(eval echo "${LAB_ASSETS_DIR}/tekton-chains-patch.yml"))"
echo "✓ Tekton Chains patch applied"

echo "Step 5.3: Waiting for tekton-chains-controller pod to be recreated..."
TIMEOUT=180
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
    NEW_CHAINS_POD=$(oc get pods -n ${PIPELINES_NAMESPACE} -l app=tekton-chains-controller -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "NotFound")

    # Check if pod name changed
    if [ "$NEW_CHAINS_POD" != "$OLD_CHAINS_POD" ] && [ "$NEW_CHAINS_POD" != "NotFound" ]; then
        # Check if new pod is ready
        POD_READY=$(oc get pod ${NEW_CHAINS_POD} -n ${PIPELINES_NAMESPACE} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "False")
        if [ "$POD_READY" == "True" ]; then
            echo "✓ Tekton Chains controller pod recreated and ready: ${NEW_CHAINS_POD}"
            break
        fi
    fi

    echo "Waiting for tekton-chains-controller pod to be recreated and ready..."
    sleep 5
    ELAPSED=$((ELAPSED + 5))
done

if [ $ELAPSED -ge $TIMEOUT ]; then
    echo "Error: tekton-chains-controller pod not recreated or not ready after ${TIMEOUT} seconds"
    exit 1
fi
echo ""

echo "========================================="
echo "RHTAS Installation Complete!"
echo "========================================="
echo ""
echo "Components deployed:"
echo "  ✓ tas-chains realm created"
echo "  ✓ Machine identity configured"
echo "  ✓ Developer identity configured"
echo "  ✓ RHTAS instance deployed (Fulcio, Rekor, Trillian, TUF)"
echo "  ✓ OIDC token refresher running"
echo "  ✓ Tekton Chains configured for keyless signing"
echo ""
echo "Next step: Run test-image-signing.sh to verify the installation"
echo ""
