#!/bin/bash
#
# Script: validate-module-1.sh
# Purpose: Validate Module 1 completion
# Checks: RHTPA installation and SBOM upload
#

set -e

# Initialize environment variables
CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}

# Namespace variables
KEYCLOAK_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_keycloak_namespace }}"
TPA_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_namespace }}"

# TPA Configuration
TPA_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_keycloak_realm }}"
TPA_CLI_CLIENT_SECRET="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_cli_client_secret }}"
SBOM_ID="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_sbom_id }}"

export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

VALIDATION_FAILED=0

echo "========================================="
echo "Validating Module 1: RHTPA Installation"
echo "========================================="
echo ""

#######################################
# Check 1: TPA Realm Import
#######################################
echo "Check 1: TPA Realm Import"
echo "-------------------------"

if oc get keycloakrealmimport ${TPA_REALM} -n ${KEYCLOAK_NAMESPACE} &>/dev/null; then
    REALM_STATUS=$(oc get keycloakrealmimport ${TPA_REALM} -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.status.conditions[?(@.type=="Done")].status}' 2>/dev/null || echo "Unknown")

    if [ "$REALM_STATUS" == "True" ]; then
        echo "✓ PASS: TPA Realm imported successfully"
    else
        echo "✗ FAIL: TPA Realm import exists but status is: ${REALM_STATUS}"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: TPA Realm import not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 2: TPA CLI Credentials Secret
#######################################
echo "Check 2: TPA CLI Credentials Secret"
echo "------------------------------------"

if oc get secret tpa-realm-cli-clients -n ${TPA_NAMESPACE} &>/dev/null; then
    echo "✓ PASS: TPA CLI credentials secret exists"
else
    echo "✗ FAIL: TPA CLI credentials secret not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 3: RHTPA Instance
#######################################
echo "Check 3: RHTPA Instance Deployment"
echo "-----------------------------------"

if oc get trustedprofileanalyzer trustedprofileanalyzer -n ${TPA_NAMESPACE} &>/dev/null; then
    echo "✓ PASS: RHTPA instance exists"

    # Check if TUF pod is running
    TUF_STATUS=$(oc get pods -n ${TPA_NAMESPACE} -l app.kubernetes.io/component=tuf -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "NotFound")
    if [ "$TUF_STATUS" == "Running" ]; then
        echo "✓ PASS: TUF pod is Running"
    else
        echo "✗ FAIL: TUF pod status is: ${TUF_STATUS}"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: RHTPA instance not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 4: RHTPA Server Endpoint
#######################################
echo "Check 4: RHTPA Server Endpoint"
echo "-------------------------------"

TPA_SERVER_URL="https://server-${TPA_NAMESPACE}.${CLUSTER_DOMAIN}"
HTTP_CODE=$(curl -k -s -o /dev/null -w "%{http_code}" ${TPA_SERVER_URL} 2>/dev/null || echo "000")

if echo "$HTTP_CODE" | grep -qE "200|302|401"; then
    echo "✓ PASS: RHTPA server is accessible (HTTP ${HTTP_CODE})"
else
    echo "✗ FAIL: RHTPA server is not accessible (HTTP ${HTTP_CODE})"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 5: SBOM Upload
#######################################
echo "Check 5: SBOM Upload Verification"
echo "----------------------------------"

# Get OAuth token
TOKEN_EP=$(curl -s "$KEYCLOAK_URL/realms/$TPA_REALM/.well-known/openid-configuration" 2>/dev/null | jq -r .token_endpoint 2>/dev/null || echo "")

if [ -n "$TOKEN_EP" ]; then
    TOKEN=$(curl -s -X POST "$TOKEN_EP" \
      -d grant_type=client_credentials \
      -d client_id="cli" \
      -d client_secret="$TPA_CLI_CLIENT_SECRET" 2>/dev/null | jq -r .access_token 2>/dev/null || echo "")

    if [ -n "$TOKEN" ] && [ "$TOKEN" != "null" ]; then
        # Check if SBOM exists
        TPA_SERVER_URL="https://$(oc get route -l app.kubernetes.io/component=server -n ${TPA_NAMESPACE} -o json 2>/dev/null | jq -r '.items[0].spec.host' 2>/dev/null || echo "")"

        if [ -n "$TPA_SERVER_URL" ] && [ "$TPA_SERVER_URL" != "https://" ]; then
            SBOM_CHECK=$(curl -s -X GET "${TPA_SERVER_URL}/api/v2/sbom?id=${SBOM_ID}" \
              -H "Authorization: Bearer ${TOKEN}" 2>/dev/null | jq -r '.id // empty' 2>/dev/null || echo "")

            if [ "$SBOM_CHECK" == "$SBOM_ID" ]; then
                echo "✓ PASS: SBOM uploaded successfully (ID: ${SBOM_ID})"
            else
                echo "⚠ WARNING: Could not verify SBOM upload (ID may not match)"
                echo "  This may be expected if SBOM was not uploaded or API changed"
            fi
        else
            echo "⚠ WARNING: Could not retrieve TPA server route for SBOM verification"
        fi
    else
        echo "⚠ WARNING: Could not authenticate to TPA API for SBOM verification"
    fi
else
    echo "⚠ WARNING: Could not retrieve token endpoint for SBOM verification"
fi
echo ""

#######################################
# Summary
#######################################
echo "========================================="
echo "Validation Summary"
echo "========================================="
echo ""

if [ $VALIDATION_FAILED -eq 0 ]; then
    echo "✓ ALL CHECKS PASSED"
    echo ""
    echo "Module 1 is complete:"
    echo "  ✓ TPA Realm imported in Keycloak"
    echo "  ✓ TPA CLI credentials configured"
    echo "  ✓ RHTPA instance deployed and running"
    echo "  ✓ RHTPA server endpoint accessible"
    echo ""
    exit 0
else
    echo "✗ VALIDATION FAILED"
    echo ""
    echo "Some checks did not pass. Please review the output above."
    echo "Run solve-module-1.sh to complete missing steps."
    echo ""
    exit 1
fi
