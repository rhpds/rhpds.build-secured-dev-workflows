#!/bin/bash
#
# Script: validate-module-4.sh
# Purpose: Validate Module 4 completion
# Checks: ACS-Quay integration and image scanning capability

set -e

# Initialize environment variables
export CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}

# Namespace variables
export ACS_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_acs_namespace }}"
export APP_CI_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_app_ci_namespace }}"
export QUAY_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_quay_namespace }}"

# Hard-coded integration name
ACS_INTEGRATION_NAME="acs_quay"

VALIDATION_FAILED=0

echo "========================================="
echo "Validating Module 4: Policy Enforcement"
echo "========================================="
echo ""

#######################################
# Check 1: ACS API Token Secret
#######################################
echo "Check 1: ACS API Token Secret"
echo "------------------------------"

if oc get secret rox-api-token -n ${APP_CI_NAMESPACE} &>/dev/null; then
    export ACS_API_TOKEN=$(oc get secret rox-api-token -n ${APP_CI_NAMESPACE} -o jsonpath='{.data.rox-api-token}' | base64 -d)

    if [ -n "$ACS_API_TOKEN" ]; then
        echo "✓ PASS: ACS API token secret exists and contains token"
    else
        echo "✗ FAIL: ACS API token is empty in secret"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: rox-api-token secret not found in ${APP_CI_NAMESPACE}"
    VALIDATION_FAILED=1
    ACS_API_TOKEN=""
fi
echo ""

#######################################
# Check 2: ACS Central Availability
#######################################
echo "Check 2: ACS Central Availability"
echo "----------------------------------"

ACS_CENTRAL_URL=$(oc get route central -n ${ACS_NAMESPACE} -o jsonpath='{.spec.host}' 2>/dev/null || echo "")

if [ -n "$ACS_CENTRAL_URL" ]; then
    HTTP_CODE=$(curl -k -s -o /dev/null -w "%{http_code}" "https://${ACS_CENTRAL_URL}" 2>/dev/null || echo "000")

    if echo "$HTTP_CODE" | grep -qE "200|302|401"; then
        echo "✓ PASS: ACS Central is accessible (HTTP ${HTTP_CODE})"
    else
        echo "✗ FAIL: ACS Central is not accessible (HTTP ${HTTP_CODE})"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: ACS Central route not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 3: ACS-Quay Integration
#######################################
echo "Check 3: ACS-Quay Integration"
echo "------------------------------"

    # Check if integration exists
    INTEGRATION_ID=$(curl -k -s -X GET "https://${ACS_CENTRAL_URL}/v1/imageintegrations" \
      -H "Authorization: Bearer ${ACS_API_TOKEN}" 2>/dev/null | jq -r ".integrations[] | select(.name==\"${ACS_INTEGRATION_NAME}\") | .id" 2>/dev/null || echo "")

    if [ -n "$INTEGRATION_ID" ]; then
        echo "✓ PASS: ACS-Quay integration exists (ID: ${INTEGRATION_ID})"

        # Get integration details
        INTEGRATION_DETAILS=$(curl -k -s -X GET "https://${ACS_CENTRAL_URL}/v1/imageintegrations/${INTEGRATION_ID}" \
          -H "Authorization: Bearer ${ACS_API_TOKEN}" 2>/dev/null || echo "")

        INTEGRATION_TYPE=$(echo "$INTEGRATION_DETAILS" | jq -r '.type // empty' 2>/dev/null || echo "")
        CATEGORIES=$(echo "$INTEGRATION_DETAILS" | jq -r '.categories[]? // empty' 2>/dev/null | tr '\n' ',' | sed 's/,$//')

        if [[ "$CATEGORIES" == *"REGISTRY"* ]] && [[ "$CATEGORIES" == *"SCANNER"* ]]; then
            echo "✓ PASS: Integration configured as Registry + Scanner"
        else
            echo "⚠ WARNING: Integration categories may not include both REGISTRY and SCANNER"
        fi
    else
        echo "✗ FAIL: ACS-Quay integration not found"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: Cannot check integration (ACS credentials not available)"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 4: roxctl availability
#######################################
echo "Check 4: roxctl CLI availability"
echo "---------------------------------"

if command -v roxctl &> /dev/null; then
    ROXCTL_VERSION=$(roxctl version 2>/dev/null | head -n 1 || echo "unknown")
    echo "✓ PASS: roxctl is available (${ROXCTL_VERSION})"
else
    echo "⚠ WARNING: roxctl CLI not found in PATH"
    echo "  Image scanning will require roxctl to be installed"
fi
echo ""

#######################################
# Summary
#######################################
echo "========================================="
echo "Validation Summary"
echo "========================================="
echo ""

if [ $VALIDATION_FAILED -eq 0 ]; then
    echo "✓ ALL CHECKS PASSED"
    echo ""
    echo "Module 4 is complete:"
    echo "  ✓ ACS Central is accessible"
    echo "  ✓ ACS-Quay integration configured"
    echo "  ✓ Ready for image scanning and policy enforcement"
    echo ""
    exit 0
else
    echo "✗ VALIDATION FAILED"
    echo ""
    echo "Some checks did not pass. Please review the output above."
    echo "Run solve-module-4.sh to complete missing steps."
    echo ""
    exit 1
fi
