#!/bin/bash
#
# Script: test-image-scanning.sh
# Purpose: Test ACS Image Scanning - Showroom Module 4 Step 1.2
#
# This script automates:
# - Step 1.2: Scan and evaluate an image

set -e

# Initialize environment variables
export CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}

# Namespace variables
export QUAY_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_quay_namespace }}"
export APP_CI_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_app_ci_namespace }}"

# Test image configuration
export QUAY_ORG="tssc"
export QUAY_REPO="tekton-chains-test"
export IMAGE_TAG="latest"

echo "========================================="
echo "Testing ACS Image Scanning"
echo "========================================="
echo ""

#######################################
# Setup roxctl authentication
#######################################
echo "Setting up roxctl authentication..."
echo "------------------------------------"

# Get ACS credentials from existing secret
echo "Retrieving ACS credentials from rox-api-token secret..."

if ! oc get secret rox-api-token -n ${APP_CI_NAMESPACE} &>/dev/null; then
    echo "Error: rox-api-token secret not found in ${APP_CI_NAMESPACE}"
    exit 1
fi

export ROX_ENDPOINT=$(oc get secret rox-api-token -n ${APP_CI_NAMESPACE} -o jsonpath='{.data.rox-api-endpoint}' | base64 -d)
export ROX_API_TOKEN=$(oc get secret rox-api-token -n ${APP_CI_NAMESPACE} -o jsonpath='{.data.rox-api-token}' | base64 -d)

if [ -z "$ROX_ENDPOINT" ] || [ -z "$ROX_API_TOKEN" ]; then
    echo "Error: Failed to retrieve ACS credentials from secret"
    exit 1
fi

echo "✓ ACS endpoint: ${ROX_ENDPOINT}"
echo "✓ ACS API token retrieved"

# Get Quay route
QUAY_URL=$(oc get route -n ${QUAY_NAMESPACE} -l quay-component=quay-app-route -o jsonpath='{.items[0].spec.host}' 2>/dev/null || echo "")

if [ -z "$QUAY_URL" ]; then
    echo "Error: Could not find Quay route"
    exit 1
fi

# Full image name
export TEST_IMAGE="${QUAY_URL}/${QUAY_ORG}/${QUAY_REPO}:${IMAGE_TAG}"
echo "Test image: ${TEST_IMAGE}"

echo "✓ roxctl configured"
echo ""

#######################################
# Step 1.2: Scan and evaluate image
#######################################
echo "Step 1.2: Scanning and evaluating image..."
echo "-------------------------------------------"

# Scan the image
echo "Running vulnerability scan..."
echo "Command: roxctl image scan --image=${TEST_IMAGE}"
echo ""

roxctl --insecure-skip-tls-verify image scan --image="${TEST_IMAGE}" || true

echo ""
echo "✓ Vulnerability scan completed"
echo ""

# Check the image against policies
echo "Running policy check..."
echo "Command: roxctl image check --image=${TEST_IMAGE}"
echo ""

roxctl --insecure-skip-tls-verify image check --image="${TEST_IMAGE}" || true

echo ""
echo "✓ Policy check completed"
echo ""

echo "========================================="
echo "Image Scanning Test Complete!"
echo "========================================="
echo ""
echo "Test Results:"
echo "  Image: ${TEST_IMAGE}"
echo "  Scan: Completed"
echo "  Policy Check: Completed"
echo ""
echo "Key Findings:"
echo "  ✓ Container images can be scanned from the registry using ACS"
echo "  ✓ Vulnerability findings are associated with specific image digest"
echo "  ✓ Policy evaluation can be performed programmatically"
echo ""
echo "These checks demonstrate that vulnerability scanning and policy"
echo "evaluation are applied consistently as part of the delivery pipeline."
echo ""
