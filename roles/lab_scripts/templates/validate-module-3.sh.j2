#!/bin/bash
#
# Script: validate-module-3.sh
# Purpose: Validate Module 3 completion
# Checks: Developer user creation, ConfigMap, and pipeline secrets
#

set -e

# Initialize environment variables
CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}
export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

# Namespace variables
KEYCLOAK_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_keycloak_namespace }}"
DEVSPACES_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_devspaces_namespace }}"
APP_CI_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_app_ci_namespace }}"

# SSO Configuration
SSO_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_sso_realm }}"
DEVELOPER_USERNAME="{{ rhpds_build_secured_dev_workflows_lab_scripts_developer_username }}"

VALIDATION_FAILED=0

echo "========================================="
echo "Validating Module 3: Developer Setup"
echo "========================================="
echo ""

# Get Keycloak admin credentials
KEYCLOAK_ADMIN_USER=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.username}' | base64 -d 2>/dev/null || echo "")
KEYCLOAK_ADMIN_PASSWORD=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.password}' | base64 -d 2>/dev/null || echo "")

# Get admin access token
ADMIN_TOKEN=""
if [ -n "$KEYCLOAK_ADMIN_USER" ] && [ -n "$KEYCLOAK_ADMIN_PASSWORD" ]; then
    ADMIN_TOKEN=$(curl -s -X POST "${KEYCLOAK_URL}/realms/master/protocol/openid-connect/token" \
      -H "Content-Type: application/x-www-form-urlencoded" \
      -d "client_id=admin-cli" \
      -d "username=${KEYCLOAK_ADMIN_USER}" \
      -d "password=${KEYCLOAK_ADMIN_PASSWORD}" \
      -d "grant_type=password" 2>/dev/null | jq -r '.access_token' 2>/dev/null || echo "")
fi

#######################################
# Check 1: Developer User Exists
#######################################
echo "Check 1: Developer User (${DEVELOPER_USERNAME})"
echo "------------------------------------------------"

if [ -n "$ADMIN_TOKEN" ] && [ "$ADMIN_TOKEN" != "null" ]; then
    USER_EXISTS=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${SSO_REALM}/users?username=${DEVELOPER_USERNAME}" 2>/dev/null | jq -r '.[0].id // empty' 2>/dev/null || echo "")

    if [ -n "$USER_EXISTS" ]; then
        echo "✓ PASS: Developer user exists"

        # Check user details
        USER_DATA=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
          "${KEYCLOAK_URL}/admin/realms/${SSO_REALM}/users/${USER_EXISTS}" 2>/dev/null || echo "")

        # Check if enabled
        USER_ENABLED=$(echo "$USER_DATA" | jq -r '.enabled // false' 2>/dev/null || echo "false")
        if [ "$USER_ENABLED" == "true" ]; then
            echo "✓ PASS: User is enabled"
        else
            echo "✗ FAIL: User is not enabled"
            VALIDATION_FAILED=1
        fi

        # Check if email verified
        EMAIL_VERIFIED=$(echo "$USER_DATA" | jq -r '.emailVerified // false' 2>/dev/null || echo "false")
        if [ "$EMAIL_VERIFIED" == "true" ]; then
            echo "✓ PASS: Email is verified"
        else
            echo "✗ FAIL: Email is not verified"
            VALIDATION_FAILED=1
        fi
    else
        echo "✗ FAIL: Developer user not found"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: Could not authenticate with Keycloak"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 2: Group Memberships
#######################################
echo "Check 2: Group Memberships"
echo "--------------------------"

if [ -n "$ADMIN_TOKEN" ] && [ "$ADMIN_TOKEN" != "null" ] && [ -n "$USER_EXISTS" ]; then
    USER_GROUPS=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${SSO_REALM}/users/${USER_EXISTS}/groups" 2>/dev/null | jq -r '.[].name' 2>/dev/null || echo "")

    # Check for tssc group
    if echo "$USER_GROUPS" | grep -q "tssc"; then
        echo "✓ PASS: User is member of 'tssc' group"
    else
        echo "✗ FAIL: User is not member of 'tssc' group"
        VALIDATION_FAILED=1
    fi

    # Check for users group
    if echo "$USER_GROUPS" | grep -q "users"; then
        echo "✓ PASS: User is member of 'users' group"
    else
        echo "✗ FAIL: User is not member of 'users' group"
        VALIDATION_FAILED=1
    fi
else
    echo "⚠ WARNING: Could not verify group memberships"
fi
echo ""

#######################################
# Check 3: Dev Spaces ConfigMap
#######################################
echo "Check 3: Dev Spaces ConfigMap"
echo "------------------------------"

if oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} &>/dev/null; then
    echo "✓ PASS: tas-git-config ConfigMap exists"

    # Check required environment variables
    TAS_FULCIO_URL=$(oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} -o jsonpath='{.data.TAS_FULCIO_URL}' 2>/dev/null || echo "")
    TAS_REKOR_URL=$(oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} -o jsonpath='{.data.TAS_REKOR_URL}' 2>/dev/null || echo "")
    TAS_ISSUER_URL=$(oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} -o jsonpath='{.data.TAS_ISSUER_URL}' 2>/dev/null || echo "")
    TAS_CLIENT_ID=$(oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} -o jsonpath='{.data.TAS_CLIENT_ID}' 2>/dev/null || echo "")

    if [ -n "$TAS_FULCIO_URL" ]; then
        echo "✓ PASS: TAS_FULCIO_URL is set"
    else
        echo "✗ FAIL: TAS_FULCIO_URL is not set"
        VALIDATION_FAILED=1
    fi

    if [ -n "$TAS_REKOR_URL" ]; then
        echo "✓ PASS: TAS_REKOR_URL is set"
    else
        echo "✗ FAIL: TAS_REKOR_URL is not set"
        VALIDATION_FAILED=1
    fi

    if [ -n "$TAS_ISSUER_URL" ]; then
        echo "✓ PASS: TAS_ISSUER_URL is set"
    else
        echo "✗ FAIL: TAS_ISSUER_URL is not set"
        VALIDATION_FAILED=1
    fi

    if [ -n "$TAS_CLIENT_ID" ]; then
        echo "✓ PASS: TAS_CLIENT_ID is set"
    else
        echo "✗ FAIL: TAS_CLIENT_ID is not set"
        VALIDATION_FAILED=1
    fi

    # Check for proper annotations
    CM_ANNOTATION=$(oc get configmap tas-git-config -n ${DEVSPACES_NAMESPACE} -o jsonpath='{.metadata.annotations.controller\.devfile\.io/mount-as}' 2>/dev/null || echo "")
    if [ "$CM_ANNOTATION" == "env" ]; then
        echo "✓ PASS: ConfigMap has correct mount annotation"
    else
        echo "✗ FAIL: ConfigMap mount annotation is incorrect (value: ${CM_ANNOTATION})"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: tas-git-config ConfigMap not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 4: Pipeline Secrets
#######################################
echo "Check 4: Pipeline Secrets"
echo "-------------------------"

# Check tpa-secret
if oc get secret tpa-secret -n ${APP_CI_NAMESPACE} &>/dev/null; then
    echo "✓ PASS: tpa-secret exists"

    # Verify it contains required data
    TPA_SECRET_DATA=$(oc get secret tpa-secret -n ${APP_CI_NAMESPACE} -o jsonpath='{.data}' 2>/dev/null || echo "")
    if echo "$TPA_SECRET_DATA" | grep -q "bombastic_api_url"; then
        echo "✓ PASS: tpa-secret contains bombastic_api_url"
    else
        echo "✗ FAIL: tpa-secret does not contain bombastic_api_url"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: tpa-secret not found"
    VALIDATION_FAILED=1
fi

# Check gitlab-auth-secret
if oc get secret gitlab-auth-secret -n ${APP_CI_NAMESPACE} &>/dev/null; then
    echo "✓ PASS: gitlab-auth-secret exists"

    # Verify it contains required data
    GITLAB_SECRET_DATA=$(oc get secret gitlab-auth-secret -n ${APP_CI_NAMESPACE} -o jsonpath='{.data}' 2>/dev/null || echo "")
    if echo "$GITLAB_SECRET_DATA" | grep -q "password"; then
        echo "✓ PASS: gitlab-auth-secret contains password"
    else
        echo "✗ FAIL: gitlab-auth-secret does not contain password"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: gitlab-auth-secret not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Summary
#######################################
echo "========================================="
echo "Validation Summary"
echo "========================================="
echo ""

if [ $VALIDATION_FAILED -eq 0 ]; then
    echo "✓ ALL CHECKS PASSED"
    echo ""
    echo "Module 3 is complete:"
    echo "  ✓ Developer user (${DEVELOPER_USERNAME}) created and enabled"
    echo "  ✓ User email verified"
    echo "  ✓ User assigned to tssc and users groups"
    echo "  ✓ Dev Spaces ConfigMap created with TAS URLs"
    echo "  ✓ Pipeline secrets created:"
    echo "    - tpa-secret (RHTPA authentication)"
    echo "    - gitlab-auth-secret (GitLab authentication)"
    echo ""
    echo "The developer environment is fully configured!"
    echo ""
    exit 0
else
    echo "✗ VALIDATION FAILED"
    echo ""
    echo "Some checks did not pass. Please review the output above."
    echo "Run solve-module-3.sh to complete missing steps."
    echo ""
    exit 1
fi
