#!/bin/bash
#
# Script: upload-sbom.sh
# Purpose: Upload SBOM to RHTPA - Showroom Module 1 Step 3.1
#

set -e

# SBOM configuration
SBOM_FILE=$(eval echo "{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_example_sbom_path }}")
SBOM_ID="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_sbom_id }}"

# Initialize environment variables
CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}

export TPA_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_keycloak_realm }}"
export TPA_CLI_CLIENT_SECRET="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_cli_client_secret }}"
export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

# Step 3.1: Ingest the SBOM into RHTPA
export TPA_SERVER_URL="https://server-{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_namespace }}.${CLUSTER_DOMAIN}"

# Ensure TPA endpoint is up before pushing SBOM
echo "Checking if TPA endpoint is ready..."
TIMEOUT=300
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
    if curl -k -s -o /dev/null -w "%{http_code}" ${TPA_SERVER_URL} | grep -q "200\|302\|401"; then
        echo "✓ TPA endpoint is ready"
        break
    fi
    echo "Waiting for TPA endpoint to be available..."
    sleep 10
    ELAPSED=$((ELAPSED + 10))
done

if [ $ELAPSED -ge $TIMEOUT ]; then
    echo "Error: TPA endpoint not ready after ${TIMEOUT} seconds"
    exit 1
fi

# Get token endpoint from Keycloak - retry if not ready
echo "Getting token endpoint from Keycloak..."
TIMEOUT=120
ELAPSED=0
TOKEN_EP=""
while [ $ELAPSED -lt $TIMEOUT ]; do
    TOKEN_EP=$(curl -s "$KEYCLOAK_URL/realms/$TPA_REALM/.well-known/openid-configuration" 2>/dev/null | jq -r .token_endpoint 2>/dev/null || true)
    if [ -n "$TOKEN_EP" ] && [ "$TOKEN_EP" != "null" ]; then
        echo "✓ Token endpoint available"
        break
    fi
    echo "Waiting for Keycloak TPA realm to be available..."
    sleep 5
    ELAPSED=$((ELAPSED + 5))
done

if [ -z "$TOKEN_EP" ] || [ "$TOKEN_EP" == "null" ]; then
    echo "Error: Could not get token endpoint from Keycloak after ${TIMEOUT} seconds"
    exit 1
fi

# Get access token
echo "Getting OAuth access token..."
TOKEN=$(curl -s -X POST "$TOKEN_EP" \
  -d grant_type=client_credentials \
  -d client_id="cli" \
  -d client_secret="$TPA_CLI_CLIENT_SECRET" 2>/dev/null | jq -r .access_token 2>/dev/null || true)

if [ -z "$TOKEN" ] || [ "$TOKEN" == "null" ]; then
    echo "Error: Failed to get OAuth access token"
    exit 1
fi
echo "✓ OAuth access token obtained"

# Upload SBOM
echo "Uploading SBOM..."
curl -X POST ${TPA_SERVER_URL}/api/v2/sbom?id=${SBOM_ID} \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  --data-binary @${SBOM_FILE}

echo ""
echo "========================================="
echo "SBOM uploaded successfully!"
echo "========================================="
echo "SBOM ID: ${SBOM_ID}"
echo "Console: ${TPA_SERVER_URL}"
echo ""
