#!/bin/bash
#
# Script: upload-sbom.sh
# Purpose: Upload SBOM to RHTPA - Showroom Module 1 Step 3.1
#

set -e

# Default SBOM configuration
SBOM_FILE="{{ lab_scripts_example_sbom_path }}"
SBOM_ID="{{ lab_scripts_sbom_id }}"

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--file) SBOM_FILE="$2"; shift 2 ;;
        -i|--id) SBOM_ID="$2"; shift 2 ;;
        -h|--help)
            echo "Usage: $0 [-f FILE] [-i ID]"
            exit 0
            ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

# Initialize environment variables
CLUSTER_DOMAIN=$(oc get ingress.config.openshift.io/cluster -o jsonpath='{.spec.domain}')

export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"
export TPA_REALM="{{ lab_scripts_tpa_keycloak_realm }}"
export TPA_CLI_CLIENT_SECRET=$(oc get keycloakrealmimport ${TPA_REALM} -n {{ lab_scripts_keycloak_namespace }} -o jsonpath='{.spec.realm.clients[?(@.clientId=="cli")].secret}')

# Step 3.1: Ingest the SBOM into RHTPA
export TPA_SERVER_URL="https://$(oc get route -l app.kubernetes.io/component=server -n {{ lab_scripts_namespace }} -o json | jq -r '.items[0].spec.host')"

# Ensure TPA endpoint is up before pushing SBOM
echo "Checking if TPA endpoint is ready..."
TIMEOUT=300
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
    if curl -k -s -o /dev/null -w "%{http_code}" ${TPA_SERVER_URL} | grep -q "200\|302\|401"; then
        echo "✓ TPA endpoint is ready"
        break
    fi
    echo "Waiting for TPA endpoint to be available..."
    sleep 10
    ELAPSED=$((ELAPSED + 10))
done

if [ $ELAPSED -ge $TIMEOUT ]; then
    echo "Error: TPA endpoint not ready after ${TIMEOUT} seconds"
    exit 1
fi

# Get OAuth token
TOKEN_EP=$(curl -s "$KEYCLOAK_URL/realms/$TPA_REALM/.well-known/openid-configuration" | jq -r .token_endpoint)

TOKEN=$(curl -s -X POST "$TOKEN_EP" \
  -d grant_type=client_credentials \
  -d client_id="cli" \
  -d client_secret="$TPA_CLI_CLIENT_SECRET" | jq -r .access_token)

# Upload SBOM
echo "Uploading SBOM..."
curl -X POST ${TPA_SERVER_URL}/api/v2/sbom?id=${SBOM_ID} \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  --data-binary @${SBOM_FILE}

echo ""
echo "========================================="
echo "SBOM uploaded successfully!"
echo "========================================="
echo "SBOM ID: ${SBOM_ID}"
echo "Console: ${TPA_SERVER_URL}"
echo ""
