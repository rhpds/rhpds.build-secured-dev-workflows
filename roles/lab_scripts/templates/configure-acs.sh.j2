#!/bin/bash
#
# Script: configure-acs.sh
# Purpose: Configure ACS-Quay Integration - Showroom Module 4 Step 1.1
#
# This script automates:
# - Step 1.1: Configure ACS - Quay Integration

set -e

# Initialize environment variables
export CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}

# Namespace variables
export ACS_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_acs_namespace }}"
export APP_CI_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_app_ci_namespace }}"
export QUAY_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_quay_namespace }}"

# Hard-coded integration name
ACS_INTEGRATION_NAME="acs_quay"

# Quay Configuration
export QUAY_TOKEN="{{ rhpds_build_secured_dev_workflows_lab_scripts_quay_token }}"

echo "========================================="
echo "Configuring ACS-Quay Integration"
echo "========================================="
echo ""

#######################################
# Step 1.1: Configure ACS - Quay Integration
#######################################
echo "Step 1.1: Configuring ACS-Quay Integration..."
echo "----------------------------------------------"

# Get ACS credentials from rox-api-token secret
echo "Retrieving ACS credentials from rox-api-token secret..."

if ! oc get secret rox-api-token -n ${APP_CI_NAMESPACE} &>/dev/null; then
    echo "Error: rox-api-token secret not found in ${APP_CI_NAMESPACE}"
    exit 1
fi

export ROX_ENDPOINT=$(oc get secret rox-api-token -n ${APP_CI_NAMESPACE} -o jsonpath='{.data.rox-api-endpoint}' | base64 -d)
export ACS_API_TOKEN=$(oc get secret rox-api-token -n ${APP_CI_NAMESPACE} -o jsonpath='{.data.rox-api-token}' | base64 -d)

if [ -z "$ROX_ENDPOINT" ] || [ -z "$ACS_API_TOKEN" ]; then
    echo "Error: Failed to retrieve ACS credentials from secret"
    exit 1
fi

# Extract hostname from ROX_ENDPOINT
ACS_CENTRAL_URL=$(echo "$ROX_ENDPOINT" | sed 's|https://||' | sed 's|:443||')

echo "ACS Central URL: https://${ACS_CENTRAL_URL}"
echo "✓ ACS API token retrieved"

# Get Quay route
QUAY_URL=$(oc get route -n ${QUAY_NAMESPACE} -l quay-component=quay-app-route -o jsonpath='{.items[0].spec.host}' 2>/dev/null || echo "")

if [ -z "$QUAY_URL" ]; then
    echo "Error: Could not find Quay route"
    exit 1
fi

echo "Quay URL: https://${QUAY_URL}"

# Check if integration already exists
echo "Checking for existing integration..."
EXISTING_INTEGRATION=$(curl -k -s -X GET "https://${ACS_CENTRAL_URL}/v1/imageintegrations" \
  -H "Authorization: Bearer ${ACS_API_TOKEN}" 2>/dev/null | jq -r ".integrations[] | select(.name==\"${ACS_INTEGRATION_NAME}\") | .id" 2>/dev/null || echo "")

if [ -n "$EXISTING_INTEGRATION" ]; then
    echo "Integration '${ACS_INTEGRATION_NAME}' already exists (ID: ${EXISTING_INTEGRATION})"
    echo "Deleting existing integration..."
    curl -k -s -X DELETE "https://${ACS_CENTRAL_URL}/v1/imageintegrations/${EXISTING_INTEGRATION}" \
      -H "Authorization: Bearer ${ACS_API_TOKEN}" > /dev/null 2>&1
    echo "✓ Deleted existing integration"
fi

# Create the integration
echo "Creating ACS-Quay integration..."

INTEGRATION_PAYLOAD=$(cat <<EOF
{
  "name": "${ACS_INTEGRATION_NAME}",
  "type": "quay",
  "categories": ["REGISTRY", "SCANNER"],
  "quay": {
    "endpoint": "https://${QUAY_URL}",
    "oauthToken": "${QUAY_TOKEN}",
    "insecure": true
  },
  "skipTestIntegration": true
}
EOF
)

CREATE_RESPONSE=$(curl -k -s -X POST "https://${ACS_CENTRAL_URL}/v1/imageintegrations" \
  -H "Authorization: Bearer ${ACS_API_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$INTEGRATION_PAYLOAD" 2>/dev/null || echo "")

INTEGRATION_ID=$(echo "$CREATE_RESPONSE" | jq -r '.id // empty' 2>/dev/null || echo "")

if [ -z "$INTEGRATION_ID" ]; then
    echo "Error: Failed to create integration"
    echo "Response: $CREATE_RESPONSE"
    exit 1
fi

echo "✓ ACS-Quay integration created (ID: ${INTEGRATION_ID})"

# Test the integration
echo "Testing integration..."
TEST_RESPONSE=$(curl -k -s -X POST "https://${ACS_CENTRAL_URL}/v1/imageintegrations/${INTEGRATION_ID}/test" \
  -H "Authorization: Bearer ${ACS_API_TOKEN}" 2>/dev/null || echo "")

echo "✓ Integration test completed"

echo ""
echo "========================================="
echo "ACS-Quay Integration Complete!"
echo "========================================="
echo ""
echo "Integration Details:"
echo "  Name: ${ACS_INTEGRATION_NAME}"
echo "  ID: ${INTEGRATION_ID}"
echo "  Endpoint: https://${QUAY_URL}"
echo "  Type: Registry + Scanner"
echo ""
echo "ACS can now scan images stored in Quay."
echo ""
