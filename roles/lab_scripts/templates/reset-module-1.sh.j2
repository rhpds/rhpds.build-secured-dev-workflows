#!/bin/bash
#
# Script: reset-module-1.sh
# Purpose: Reset Module 1 to initial state
# Undoes: RHTPA installation and SBOM upload
#

set -e

# Initialize environment variables
CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}

# Namespace variables
KEYCLOAK_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_keycloak_namespace }}"
TPA_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_namespace }}"

# TPA Configuration
TPA_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tpa_keycloak_realm }}"

echo "========================================="
echo "Resetting Module 1: RHTPA Installation"
echo "========================================="
echo ""

#######################################
# Step 1: Delete RHTPA Instance
#######################################
echo "Step 1: Deleting RHTPA instance..."
echo "-----------------------------------"

if oc get tpa -n ${TPA_NAMESPACE} instance 2>/dev/null; then
    oc delete tpa instance -n ${TPA_NAMESPACE}
    echo "✓ RHTPA instance deleted"

    # Wait for resources to be cleaned up
    echo "Waiting for RHTPA resources to be cleaned up..."
    sleep 10
else
    echo "✓ RHTPA instance not found (already clean)"
fi
echo ""

#######################################
# Step 2: Delete TPA CLI Credentials Secret
#######################################
echo "Step 2: Deleting TPA CLI credentials secret..."
echo "-----------------------------------------------"

if oc get secret tpa-cli-credentials -n ${TPA_NAMESPACE} 2>/dev/null; then
    oc delete secret tpa-cli-credentials -n ${TPA_NAMESPACE}
    echo "✓ TPA CLI credentials secret deleted"
else
    echo "✓ TPA CLI credentials secret not found (already clean)"
fi
echo ""

#######################################
# Step 3: Delete TPA Realm Import
#######################################
echo "Step 3: Deleting TPA Realm import..."
echo "-------------------------------------"

if oc get keycloakrealmimport ${TPA_REALM} -n ${KEYCLOAK_NAMESPACE} 2>/dev/null; then
    oc delete keycloakrealmimport ${TPA_REALM} -n ${KEYCLOAK_NAMESPACE}
    echo "✓ TPA Realm import deleted"

    # Wait for realm to be removed
    echo "Waiting for TPA Realm to be removed..."
    sleep 5
else
    echo "✓ TPA Realm import not found (already clean)"
fi
echo ""

echo "========================================="
echo "Module 1 Reset Complete!"
echo "========================================="
echo ""
echo "Cleaned up:"
echo "  ✓ RHTPA instance removed"
echo "  ✓ TPA CLI credentials secret removed"
echo "  ✓ TPA Realm removed from Keycloak"
echo ""
echo "Note: SBOM data is stored in the RHTPA database which"
echo "      has been removed along with the RHTPA instance."
echo ""
