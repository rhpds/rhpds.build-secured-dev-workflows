#!/bin/bash
#
# Script: solve-module-3.sh
# Purpose: Complete all steps for Module 3
# Steps: Create Developer User + Create ConfigMap + Create Pipeline Secrets
#

set -e

# Initialize environment variables
export LAB_ASSETS_DIR="{{ rhpds_build_secured_dev_workflows_lab_scripts_output_dir }}"

echo "========================================="
echo "Solving Module 3: Developer Setup"
echo "========================================="
echo ""

# Step 0: Reset Module 3
echo "Running Step 0: Reset Module 3..."
echo "=================================="
bash ${LAB_ASSETS_DIR}/reset-module-3.sh
echo ""

# Step 1: Create Developer User
echo "Running Step 1: Create Developer User..."
echo "========================================="
bash ${LAB_ASSETS_DIR}/create-developer-user.sh
echo ""

# Step 2: Update GitOps Backstage Configuration
echo "Running Step 2: Update GitOps Backstage Configuration..."
echo "========================================================="
bash ${LAB_ASSETS_DIR}/update-gitops-backstage-config.sh update
echo ""

# Step 3: Update RHDH Devfile Configuration
echo "Running Step 3: Update RHDH Devfile Configuration..."
echo "====================================================="
bash ${LAB_ASSETS_DIR}/update-rhdh-devfile-config.sh update
echo ""

# Step 4: Create Dev Spaces ConfigMap
echo "Running Step 4: Create Dev Spaces ConfigMap..."
echo "==============================================="
bash ${LAB_ASSETS_DIR}/create-devspaces-configmap.sh
echo ""

# Step 5: Create Pipeline Secrets
echo "Running Step 5: Create Pipeline Secrets..."
echo "==========================================="
bash ${LAB_ASSETS_DIR}/create-pipeline-secrets.sh
echo ""

echo "========================================="
echo "Module 3 Complete!"
echo "========================================="
echo ""
echo "Summary:"
echo "  ✓ Developer user created in Keycloak"
echo "  ✓ User assigned to tssc and users groups"
echo "  ✓ Dev Spaces ConfigMap created with TAS URLs"
echo "  ✓ Pipeline secrets created:"
echo "    - tpa-secret (RHTPA authentication)"
echo "    - gitlab-auth-secret (GitLab authentication)"
echo "  ✓ GitOps backstage configuration updated"
echo "  ✓ RHDH devfile configuration updated"
echo ""
echo "The developer environment is now fully configured!"
echo ""
