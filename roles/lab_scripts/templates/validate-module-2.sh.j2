#!/bin/bash
#
# Script: validate-module-2.sh
# Purpose: Validate Module 2 completion
# Checks: RHTAS installation and image signing configuration
#

set -e

# Initialize environment variables
CLUSTER_DOMAIN={{ openshift_cluster_ingress_domain }}
export KEYCLOAK_URL="https://sso.${CLUSTER_DOMAIN}"

# Namespace variables
KEYCLOAK_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_keycloak_namespace }}"
TAS_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_namespace }}"
PIPELINES_NAMESPACE="{{ rhpds_build_secured_dev_workflows_lab_scripts_pipelines_namespace }}"

# TAS Configuration
TAS_CHAINS_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_chains_realm }}"
TAS_SSO_REALM="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_sso_realm }}"
TAS_CLIENT_ID="{{ rhpds_build_secured_dev_workflows_lab_scripts_tas_client_id }}"

VALIDATION_FAILED=0

echo "========================================="
echo "Validating Module 2: RHTAS Installation"
echo "========================================="
echo ""

# Get Keycloak admin credentials
KEYCLOAK_ADMIN_USER=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.username}' | base64 -d 2>/dev/null || echo "")
KEYCLOAK_ADMIN_PASSWORD=$(oc get secret keycloak-initial-admin -n ${KEYCLOAK_NAMESPACE} -o jsonpath='{.data.password}' | base64 -d 2>/dev/null || echo "")

# Get admin access token
ADMIN_TOKEN=""
if [ -n "$KEYCLOAK_ADMIN_USER" ] && [ -n "$KEYCLOAK_ADMIN_PASSWORD" ]; then
    ADMIN_TOKEN=$(curl -s -X POST "${KEYCLOAK_URL}/realms/master/protocol/openid-connect/token" \
      -H "Content-Type: application/x-www-form-urlencoded" \
      -d "client_id=admin-cli" \
      -d "username=${KEYCLOAK_ADMIN_USER}" \
      -d "password=${KEYCLOAK_ADMIN_PASSWORD}" \
      -d "grant_type=password" 2>/dev/null | jq -r '.access_token' 2>/dev/null || echo "")
fi

#######################################
# Check 1: tas-chains Realm
#######################################
echo "Check 1: tas-chains Realm"
echo "-------------------------"

if [ -n "$ADMIN_TOKEN" ] && [ "$ADMIN_TOKEN" != "null" ]; then
    REALM_EXISTS=$(curl -s -o /dev/null -w "%{http_code}" \
      -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}" 2>/dev/null || echo "000")

    if [ "$REALM_EXISTS" == "200" ]; then
        echo "✓ PASS: tas-chains realm exists"
    else
        echo "✗ FAIL: tas-chains realm not found"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: Could not authenticate with Keycloak"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 2: trusted-artifact-signer Client in tas-chains
#######################################
echo "Check 2: ${TAS_CLIENT_ID} Client in tas-chains Realm"
echo "-----------------------------------------------------"

if [ -n "$ADMIN_TOKEN" ] && [ "$ADMIN_TOKEN" != "null" ]; then
    CLIENT_EXISTS=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients?clientId=${TAS_CLIENT_ID}" 2>/dev/null | jq -r '.[0].id // empty' 2>/dev/null || echo "")

    if [ -n "$CLIENT_EXISTS" ]; then
        echo "✓ PASS: ${TAS_CLIENT_ID} client exists in tas-chains realm"

        # Check service account user email verification
        SERVICE_ACCOUNT_USER=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
          "${KEYCLOAK_URL}/admin/realms/${TAS_CHAINS_REALM}/clients/${CLIENT_EXISTS}/service-account-user" 2>/dev/null | jq -r '.emailVerified // false' 2>/dev/null || echo "false")

        if [ "$SERVICE_ACCOUNT_USER" == "true" ]; then
            echo "✓ PASS: Service account email is verified"
        else
            echo "✗ FAIL: Service account email is not verified"
            VALIDATION_FAILED=1
        fi
    else
        echo "✗ FAIL: ${TAS_CLIENT_ID} client not found in tas-chains realm"
        VALIDATION_FAILED=1
    fi
else
    echo "⚠ WARNING: Could not verify client (authentication issue)"
fi
echo ""

#######################################
# Check 3: trusted-artifact-signer Client in sso Realm
#######################################
echo "Check 3: ${TAS_CLIENT_ID} Client in sso Realm"
echo "----------------------------------------------"

if [ -n "$ADMIN_TOKEN" ] && [ "$ADMIN_TOKEN" != "null" ]; then
    SSO_CLIENT_EXISTS=$(curl -s -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      "${KEYCLOAK_URL}/admin/realms/${TAS_SSO_REALM}/clients?clientId=${TAS_CLIENT_ID}" 2>/dev/null | jq -r '.[0].id // empty' 2>/dev/null || echo "")

    if [ -n "$SSO_CLIENT_EXISTS" ]; then
        echo "✓ PASS: ${TAS_CLIENT_ID} client exists in sso realm"
    else
        echo "✗ FAIL: ${TAS_CLIENT_ID} client not found in sso realm"
        VALIDATION_FAILED=1
    fi
else
    echo "⚠ WARNING: Could not verify client (authentication issue)"
fi
echo ""

#######################################
# Check 4: RHTAS Instance
#######################################
echo "Check 4: RHTAS Instance Deployment"
echo "-----------------------------------"

if oc get securesign -n ${TAS_NAMESPACE} instance &>/dev/null; then
    echo "✓ PASS: RHTAS instance exists"

    # Check if TUF pod is running
    TUF_STATUS=$(oc get pods -n ${TAS_NAMESPACE} -l app.kubernetes.io/component=tuf -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "NotFound")
    if [ "$TUF_STATUS" == "Running" ]; then
        echo "✓ PASS: TUF pod is Running"
    else
        echo "✗ FAIL: TUF pod status is: ${TUF_STATUS}"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: RHTAS instance not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 5: OIDC Refresher App
#######################################
echo "Check 5: OIDC Token Refresher"
echo "------------------------------"

if oc get secret oidc-info -n ${PIPELINES_NAMESPACE} &>/dev/null; then
    echo "✓ PASS: oidc-info secret exists"
else
    echo "✗ FAIL: oidc-info secret not found"
    VALIDATION_FAILED=1
fi

if oc get deployment oidc-token-refresher -n ${PIPELINES_NAMESPACE} &>/dev/null; then
    echo "✓ PASS: OIDC refresher deployment exists"

    # Check if pod is running
    REFRESHER_STATUS=$(oc get pods -n ${PIPELINES_NAMESPACE} -l app=oidc-token-refresher -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "NotFound")
    if [ "$REFRESHER_STATUS" == "Running" ]; then
        echo "✓ PASS: OIDC refresher pod is Running"
    else
        echo "✗ FAIL: OIDC refresher pod status is: ${REFRESHER_STATUS}"
        VALIDATION_FAILED=1
    fi
else
    echo "✗ FAIL: OIDC refresher deployment not found"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Check 6: Tekton Chains Configuration
#######################################
echo "Check 6: Tekton Chains Configuration"
echo "-------------------------------------"

# Check artifacts.oci.storage
OCI_STORAGE=$(oc get tektonconfig config -n ${PIPELINES_NAMESPACE} -o jsonpath='{.spec.chain.artifacts\.oci\.storage}' 2>/dev/null || echo "")
if [ "$OCI_STORAGE" == "oci" ]; then
    echo "✓ PASS: Tekton Chains OCI storage is configured"
else
    echo "✗ FAIL: Tekton Chains OCI storage is not configured (value: ${OCI_STORAGE})"
    VALIDATION_FAILED=1
fi

# Check artifacts.taskrun.format
TASKRUN_FORMAT=$(oc get tektonconfig config -n ${PIPELINES_NAMESPACE} -o jsonpath='{.spec.chain.artifacts\.taskrun\.format}' 2>/dev/null || echo "")
if [ "$TASKRUN_FORMAT" == "in-toto" ]; then
    echo "✓ PASS: Tekton Chains TaskRun format is in-toto"
else
    echo "✗ FAIL: Tekton Chains TaskRun format is not in-toto (value: ${TASKRUN_FORMAT})"
    VALIDATION_FAILED=1
fi

# Check artifacts.taskrun.storage
TASKRUN_STORAGE=$(oc get tektonconfig config -n ${PIPELINES_NAMESPACE} -o jsonpath='{.spec.chain.artifacts\.taskrun\.storage}' 2>/dev/null || echo "")
if [ "$TASKRUN_STORAGE" == "oci" ]; then
    echo "✓ PASS: Tekton Chains TaskRun storage is OCI"
else
    echo "✗ FAIL: Tekton Chains TaskRun storage is not OCI (value: ${TASKRUN_STORAGE})"
    VALIDATION_FAILED=1
fi

# Check transparency.enabled
TRANSPARENCY=$(oc get tektonconfig config -n ${PIPELINES_NAMESPACE} -o jsonpath='{.spec.chain.transparency\.enabled}' 2>/dev/null || echo "")
if [ "$TRANSPARENCY" == "true" ]; then
    echo "✓ PASS: Tekton Chains transparency is enabled"
else
    echo "✗ FAIL: Tekton Chains transparency is not enabled (value: ${TRANSPARENCY})"
    VALIDATION_FAILED=1
fi
echo ""

#######################################
# Summary
#######################################
echo "========================================="
echo "Validation Summary"
echo "========================================="
echo ""

if [ $VALIDATION_FAILED -eq 0 ]; then
    echo "✓ ALL CHECKS PASSED"
    echo ""
    echo "Module 2 is complete:"
    echo "  ✓ tas-chains realm created in Keycloak"
    echo "  ✓ Machine identity configured (service account)"
    echo "  ✓ Developer identity configured (sso realm client)"
    echo "  ✓ RHTAS instance deployed (Fulcio, Rekor, TUF)"
    echo "  ✓ OIDC token refresher running"
    echo "  ✓ Tekton Chains configured for keyless signing"
    echo ""
    echo "Note: To verify image signing works, check that a"
    echo "TaskRun has been executed and the image is signed."
    echo ""
    exit 0
else
    echo "✗ VALIDATION FAILED"
    echo ""
    echo "Some checks did not pass. Please review the output above."
    echo "Run solve-module-2.sh to complete missing steps."
    echo ""
    exit 1
fi
